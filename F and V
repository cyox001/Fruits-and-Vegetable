<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Garden Harvest — Fruit & Vegetable Vocabulary Game</title>
  <!-- Google Fonts: Fredoka for playful, beginner-friendly rounded letterforms -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    :root {
      --sky-top: #E6F7FF;
      --sky-bottom: #FFFDF5;
      --grass-light: #B8E986;
      --grass-mid: #8CD458;
      --grass-dark: #6AB83A;
      --wood-light: #E8B87D;
      --wood-mid: #C68B49;
      --wood-dark: #8C5828;
      --cream: #FFFDF7;
    }

    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: none;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Fredoka', sans-serif;
      background: linear-gradient(135deg, #2d4c2b 0%, #1d351c 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* Responsive 16:9 Stage Container */
    #stage-wrapper {
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: min(1.5vw, 14px);
    }

    #game-stage {
      position: relative;
      width: 100%;
      max-width: 177.78vh; /* Maintain 16:9 within viewport height */
      aspect-ratio: 16 / 9;
      max-height: 100%;
      background: linear-gradient(180deg, #DCF4FF 0%, #F4FBE8 56%, #B4E57A 56.5%, #93D253 100%);
      border-radius: 28px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.38), inset 0 0 0 5px rgba(255, 255, 255, 0.65);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    /* Fullscreen adjustment */
    #game-stage:fullscreen,
    #game-stage:-webkit-full-screen {
      max-width: 100vw;
      max-height: 100vh;
      border-radius: 0;
    }

    /* Gentle Floating Clouds */
    @keyframes floatSlow {
      0%, 100% { transform: translateX(0px); }
      50% { transform: translateX(18px); }
    }
    .cloud-float-1 { animation: floatSlow 11s ease-in-out infinite; }
    .cloud-float-2 { animation: floatSlow 15s ease-in-out infinite reverse; }

    /* Card Pop-in Animation */
    @keyframes popIn {
      0% { transform: scale(0.5) translateY(20px); opacity: 0; }
      70% { transform: scale(1.06) translateY(-4px); opacity: 1; }
      100% { transform: scale(1) translateY(0); opacity: 1; }
    }
    .animate-pop-in {
      animation: popIn 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    /* Gentle Idle Bob for Active Item */
    @keyframes gentleBob {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-6px) rotate(1.5deg); }
    }
    .idle-bob {
      animation: gentleBob 3s ease-in-out infinite;
    }

    /* Container Happy Bounce on Catch */
    @keyframes basketSquish {
      0% { transform: scale(1, 1); }
      30% { transform: scale(1.13, 0.88); }
      60% { transform: scale(0.95, 1.06); }
      100% { transform: scale(1, 1); }
    }
    .animate-catch {
      animation: basketSquish 0.48s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* Drop zone highlight pulse */
    .drop-zone-active {
      transform: scale(1.06);
      filter: drop-shadow(0 0 22px rgba(255, 224, 92, 0.95));
    }

    /* Draggable Item Styling */
    #draggable-card {
      touch-action: none;
      cursor: grab;
      transition: box-shadow 0.2s ease, transform 0.15s ease;
      z-index: 30;
    }
    #draggable-card:active,
    #draggable-card.is-dragging {
      cursor: grabbing;
      z-index: 60;
    }

    /* Sparkle / Leaf Particle Animation */
    @keyframes particleBurst {
      0% {
        transform: translate(0, 0) scale(0.4) rotate(0deg);
        opacity: 1;
      }
      100% {
        transform: translate(var(--tx), var(--ty)) scale(1.15) rotate(var(--rot));
        opacity: 0;
      }
    }
    .particle {
      position: absolute;
      pointer-events: none;
      z-index: 70;
      animation: particleBurst 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Custom Scrollbar for Settings Drawer */
    .garden-scroll::-webkit-scrollbar {
      width: 8px;
    }
    .garden-scroll::-webkit-scrollbar-track {
      background: #F4EFE2;
      border-radius: 99px;
    }
    .garden-scroll::-webkit-scrollbar-thumb {
      background: #C9B99A;
      border-radius: 99px;
    }
    .garden-scroll::-webkit-scrollbar-thumb:hover {
      background: #A99573;
    }

    /* Tactile 3D Button Style */
    .btn-tactile {
      transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.15s ease;
    }
    .btn-tactile:active {
      transform: translateY(3px);
    }
  </style>
</head>
<body>
  <div id="stage-wrapper">
    <main id="game-stage" aria-label="Garden Harvest Vocabulary Game">
      
      <!-- DECORATIVE GARDEN BACKGROUND LAYER (SVG) -->
      <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs>
          <radialGradient id="sunGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#FFF4A3" stop-opacity="0.95" />
            <stop offset="60%" stop-color="#FFE066" stop-opacity="0.35" />
            <stop offset="100%" stop-color="#FFE066" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="hillBack" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#BCE98A" />
            <stop offset="100%" stop-color="#9BD664" />
          </linearGradient>
          <linearGradient id="hillFront" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#A6DF6E" />
            <stop offset="100%" stop-color="#7EC343" />
          </linearGradient>
        </defs>

        <!-- Warm Sun in upper center-left -->
        <circle cx="810" cy="145" r="145" fill="url(#sunGlow)" />
        <circle cx="810" cy="145" r="46" fill="#FFD93D" />

        <!-- Fluffy Clouds -->
        <g class="cloud-float-1" fill="#FFFFFF" opacity="0.9">
          <circle cx="240" cy="150" r="36" />
          <circle cx="280" cy="140" r="46" />
          <circle cx="325" cy="152" r="34" />
          <rect x="235" y="152" width="95" height="34" rx="17" />
        </g>

        <g class="cloud-float-2" fill="#FFFFFF" opacity="0.85">
          <circle cx="1230" cy="165" r="32" />
          <circle cx="1268" cy="152" r="44" />
          <circle cx="1312" cy="165" r="30" />
          <rect x="1225" y="164" width="92" height="32" rx="16" />
        </g>

        <!-- Distant Rolling Garden Hills -->
        <path d="M-50 540 Q 380 410 850 515 T 1650 475 L 1650 900 L -50 900 Z" fill="url(#hillBack)" />
        <path d="M-50 565 Q 520 485 1040 555 T 1650 520 L 1650 900 L -50 900 Z" fill="url(#hillFront)" />

        <!-- Cozy Garden Picket Fence along Horizon -->
        <g transform="translate(0, 442)" fill="#FFFDF7" stroke="#DFD5C2" stroke-width="2.5">
          <!-- Horizontal Rails -->
          <rect x="0" y="26" width="1600" height="12" rx="4" />
          <rect x="0" y="64" width="1600" height="12" rx="4" />
          <!-- Pickets -->
          <g id="fence-pickets">
            <path d="M40 95 L40 18 L56 2 L72 18 L72 95 Z" />
            <path d="M125 95 L125 18 L141 2 L157 18 L157 95 Z" />
            <path d="M210 95 L210 18 L226 2 L242 18 L242 95 Z" />
            <path d="M295 95 L295 18 L311 2 L327 18 L327 95 Z" />
            <path d="M380 95 L380 18 L396 2 L412 18 L412 95 Z" />
            <path d="M465 95 L465 18 L481 2 L497 18 L497 95 Z" />
            <path d="M550 95 L550 18 L566 2 L582 18 L582 95 Z" />
            <path d="M635 95 L635 18 L651 2 L667 18 L667 95 Z" />
            <path d="M720 95 L720 18 L736 2 L752 18 L752 95 Z" />
            <path d="M805 95 L805 18 L821 2 L837 18 L837 95 Z" />
            <path d="M890 95 L890 18 L906 2 L922 18 L922 95 Z" />
            <path d="M975 95 L975 18 L991 2 L1007 18 L1007 95 Z" />
            <path d="M1060 95 L1060 18 L1076 2 L1092 18 L1092 95 Z" />
            <path d="M1145 95 L1145 18 L1161 2 L1177 18 L1177 95 Z" />
            <path d="M1230 95 L1230 18 L1246 2 L1262 18 L1262 95 Z" />
            <path d="M1315 95 L1315 18 L1331 2 L1347 18 L1347 95 Z" />
            <path d="M1400 95 L1400 18 L1416 2 L1432 18 L1432 95 Z" />
            <path d="M1485 95 L1485 18 L1501 2 L1517 18 L1517 95 Z" />
          </g>
        </g>

        <!-- Soft Garden Bushes -->
        <g fill="#68B638">
          <circle cx="95" cy="535" r="46" />
          <circle cx="145" cy="542" r="38" />
          <circle cx="52" cy="548" r="32" />
          <circle cx="1505" cy="530" r="50" />
          <circle cx="1450" cy="540" r="36" />
          <circle cx="1555" cy="544" r="34" />
        </g>

        <!-- Sweet Little Garden Wildflowers -->
        <g transform="translate(160, 770)">
          <circle cx="0" cy="-10" r="8" fill="#FFF" />
          <circle cx="10" cy="0" r="8" fill="#FFF" />
          <circle cx="0" cy="10" r="8" fill="#FFF" />
          <circle cx="-10" cy="0" r="8" fill="#FFF" />
          <circle cx="0" cy="0" r="6" fill="#FFD93D" />
        </g>
        <g transform="translate(765, 795)">
          <circle cx="0" cy="-9" r="7" fill="#FF9EBB" />
          <circle cx="9" cy="0" r="7" fill="#FF9EBB" />
          <circle cx="0" cy="9" r="7" fill="#FF9EBB" />
          <circle cx="-9" cy="0" r="7" fill="#FF9EBB" />
          <circle cx="0" cy="0" r="5.5" fill="#FFF3B0" />
        </g>
        <g transform="translate(1435, 785)">
          <circle cx="0" cy="-9" r="7.5" fill="#FFF" />
          <circle cx="9" cy="0" r="7.5" fill="#FFF" />
          <circle cx="0" cy="9" r="7.5" fill="#FFF" />
          <circle cx="-9" cy="0" r="7.5" fill="#FFF" />
          <circle cx="0" cy="0" r="5.5" fill="#FFD93D" />
        </g>

        <!-- Gentle Curved Dotted Path Connecting Left Stand to Right Basket/Crate -->
        <path d="M 520 695 Q 800 745 1075 685" fill="none" stroke="#F6E8C8" stroke-width="14" stroke-linecap="round" stroke-dasharray="22 26" opacity="0.85" />
      </svg>

      <!-- TOP NAVIGATION BAR -->
      <header class="relative z-40 flex items-center justify-between px-4 sm:px-7 pt-3 sm:pt-4 pb-2">
        <!-- Brand / Garden Title Pill -->
        <div class="flex items-center gap-2.5 bg-white/90 backdrop-blur-sm px-3.5 sm:px-5 py-2 rounded-full shadow-md border-2 border-amber-200/80">
          <span class="text-xl sm:text-2xl" role="img" aria-label="Sprout">🌱</span>
          <span class="font-bold text-emerald-800 text-base sm:text-xl tracking-tight hidden md:inline">Garden Harvest</span>
          <!-- Progress Counter Pill -->
          <span id="progress-badge" class="ml-1 px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold text-xs sm:text-sm">
            0 / 6
          </span>
        </div>

        <!-- Center Mode Switcher: Fruit vs Vegetable -->
        <div class="flex items-center gap-2 sm:gap-3 bg-white/85 backdrop-blur-sm p-1.5 rounded-full shadow-lg border-2 border-amber-200/80" role="tablist" aria-label="Choose Vocabulary Category">
          <button
            id="btn-mode-fruit"
            role="tab"
            aria-selected="true"
            class="btn-tactile flex items-center gap-2 px-4 sm:px-6 py-2 sm:py-2.5 rounded-full font-bold text-base sm:text-xl cursor-pointer bg-gradient-to-b from-rose-400 to-rose-500 text-white shadow-[0_4px_0_#be123c]"
          >
            <span class="text-xl sm:text-2xl">🍎</span>
            <span>Fruit</span>
          </button>

          <button
            id="btn-mode-vegetable"
            role="tab"
            aria-selected="false"
            class="btn-tactile flex items-center gap-2 px-4 sm:px-6 py-2 sm:py-2.5 rounded-full font-bold text-base sm:text-xl cursor-pointer bg-amber-50 hover:bg-emerald-50 text-emerald-900"
          >
            <span class="text-xl sm:text-2xl">🥕</span>
            <span>Vegetable</span>
          </button>
        </div>

        <!-- Right Utility Controls: Sound Toggle, Settings, Fullscreen -->
        <div class="flex items-center gap-2 sm:gap-2.5">
          <!-- Sound Mute Toggle -->
          <button
            id="btn-sound"
            title="Toggle Sound Effects"
            aria-label="Toggle Sound Effects"
            class="btn-tactile w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white/95 hover:bg-amber-50 text-amber-800 border-2 border-amber-200 shadow-[0_4px_0_#d9770633] flex items-center justify-center cursor-pointer"
          >
            <svg id="icon-sound-on" class="w-6 h-6 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
            </svg>
            <svg id="icon-sound-off" class="w-6 h-6 text-rose-500 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <line x1="23" y1="9" x2="17" y2="15"></line>
              <line x1="17" y1="9" x2="23" y2="15"></line>
            </svg>
          </button>

          <!-- Settings Gear Button -->
          <button
            id="btn-settings"
            title="Manage Fruit & Vegetable Words"
            aria-label="Manage Fruit & Vegetable Words"
            class="btn-tactile flex items-center gap-1.5 px-3.5 sm:px-4 h-11 sm:h-12 rounded-full bg-white/95 hover:bg-amber-50 text-amber-900 border-2 border-amber-200 shadow-[0_4px_0_#d9770633] font-bold text-sm sm:text-base cursor-pointer"
          >
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            <span class="hidden sm:inline">Settings</span>
          </button>

          <!-- Fullscreen Toggle -->
          <button
            id="btn-fullscreen"
            title="Toggle Fullscreen"
            aria-label="Toggle Fullscreen"
            class="btn-tactile w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white/95 hover:bg-amber-50 text-amber-800 border-2 border-amber-200 shadow-[0_4px_0_#d9770633] flex items-center justify-center cursor-pointer"
          >
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-amber-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
            </svg>
          </button>
        </div>
      </header>

      <!-- MAIN PLAYFIELD: LEFT GARDEN STAND & RIGHT BASKET/CRATE -->
      <div id="playfield" class="relative flex-1 grid grid-cols-2 items-center px-4 sm:px-10 pb-4">
        
        <!-- LEFT SIDE: WOODEN GARDEN DISPLAY STAND + ACTIVE VOCABULARY ITEM -->
        <div class="relative h-full flex flex-col items-center justify-center">
          
          <!-- Wooden Display Stand Backdrop -->
          <div class="relative flex flex-col items-center justify-center w-[78%] max-w-[360px] aspect-[4/4.3]">
            <!-- Wooden Signpost SVG Frame -->
            <svg class="absolute inset-0 w-full h-full pointer-events-none drop-shadow-xl" viewBox="0 0 360 390">
              <!-- Wooden Post Going into Grass -->
              <rect x="156" y="295" width="48" height="92" rx="8" fill="#9E622B" stroke="#6E4119" stroke-width="4" />
              <line x1="170" y1="305" x2="170" y2="375" stroke="#855020" stroke-width="3" stroke-linecap="round" />
              <line x1="190" y1="305" x2="190" y2="375" stroke="#855020" stroke-width="3" stroke-linecap="round" />
              <!-- Outer Wooden Frame -->
              <rect x="14" y="14" width="332" height="296" rx="34" fill="#C98A4B" stroke="#7D4B1E" stroke-width="5" />
              <!-- Inner Cream Sign Board -->
              <rect x="30" y="30" width="300" height="264" rx="24" fill="#FFFDF7" stroke="#E5C89B" stroke-width="3" />
              <!-- Corner Brass Nails -->
              <circle cx="44" cy="44" r="5" fill="#D9A05B" />
              <circle cx="316" cy="44" r="5" fill="#D9A05B" />
              <circle cx="44" cy="280" r="5" fill="#D9A05B" />
              <circle cx="316" cy="280" r="5" fill="#D9A05B" />
            </svg>

            <!-- Placeholder Ghost Outline when Dragging -->
            <div id="stand-placeholder" class="w-[68%] h-[68%] rounded-3xl border-4 border-dashed border-amber-300/80 flex items-center justify-center text-amber-400 font-semibold text-base sm:text-lg text-center px-4">
              Drop in the <span id="placeholder-target-name" class="mx-1 underline">basket</span>!
            </div>

            <!-- DRAGGABLE VOCABULARY CARD (Appears 1 at a time) -->
            <div
              id="draggable-card"
              role="button"
              tabindex="0"
              aria-label="Draggable vocabulary item"
              class="absolute top-[11%] w-[74%] aspect-square bg-white rounded-3xl shadow-[0_12px_28px_rgba(120,72,24,0.18)] border-4 border-amber-200 flex flex-col items-center justify-between p-3 sm:p-4 select-none"
            >
              <!-- Speaker Button in Top-Right Corner of Card -->
              <button
                id="btn-speak-word"
                type="button"
                title="Listen to word"
                aria-label="Listen to word"
                class="btn-tactile absolute top-2.5 right-2.5 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-sky-100 hover:bg-sky-200 text-sky-700 flex items-center justify-center shadow-sm cursor-pointer z-20"
              >
                <svg class="w-5 h-5 sm:w-6 sm:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                  <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                </svg>
              </button>

              <!-- Illustration Container -->
              <div id="card-art" class="idle-bob w-[66%] h-[66%] flex items-center justify-center mt-1 pointer-events-none">
                <!-- SVG or User Image injected dynamically -->
              </div>

              <!-- Beginner-Friendly Vocabulary Label -->
              <div id="card-label" class="w-full text-center font-bold text-slate-800 text-2xl sm:text-3xl md:text-4xl tracking-wide pb-0.5 pointer-events-none truncate">
                apple
              </div>
            </div>

            <!-- Helper Hint Pill Below Stand -->
            <div id="drag-hint-pill" class="absolute -bottom-3 bg-white/95 px-4 py-1.5 rounded-full shadow-md border-2 border-amber-200 text-amber-900 font-semibold text-xs sm:text-sm flex items-center gap-1.5">
              <span>👆 Drag to the</span>
              <span id="hint-container-word" class="font-bold text-rose-600">basket</span>
              <span>👉</span>
            </div>
          </div>
        </div>

        <!-- RIGHT SIDE: WOVEN BASKET (FRUIT) OR WOODEN CRATE (VEGETABLE) DROP ZONE -->
        <div class="relative h-full flex flex-col items-center justify-center">
          <div
            id="drop-container"
            class="relative w-[84%] max-w-[420px] aspect-[4/3.6] flex flex-col items-center justify-center transition-transform duration-200"
          >
            <!-- Soft Ground Shadow Beneath Basket/Crate -->
            <div class="absolute bottom-[6%] w-[82%] h-[14%] rounded-full bg-emerald-950/20 blur-sm pointer-events-none"></div>

            <!-- BACK LAYER OF CONTAINERS (Behind stacked items) -->
            <!-- Basket Back (Handle + Dark Interior Opening) -->
            <svg id="svg-basket-back" class="absolute inset-0 z-10 w-full h-full drop-shadow-xl pointer-events-none" viewBox="0 0 420 360">
              <!-- Basket Handle -->
              <path d="M 95 165 C 95 45, 325 45, 325 165" fill="none" stroke="#9C622B" stroke-width="22" stroke-linecap="round" />
              <path d="M 95 165 C 95 45, 325 45, 325 165" fill="none" stroke="#C98A4B" stroke-width="14" stroke-linecap="round" stroke-dasharray="18 10" />
              <!-- Basket Dark Interior Opening -->
              <ellipse cx="210" cy="168" rx="152" ry="34" fill="#6E4019" />
            </svg>

            <!-- Crate Back (Interior Depth & Back Wall) -->
