<!-- Toast Notification Banner (No alert() used!) -->
<div id="toast-msg" class="hidden fixed bottom-12 left-1/2 -translate-x-1/2 z-50 bg-slate-900 text-white font-extrabold px-6 py-3 rounded-2xl shadow-2xl border-2 border-amber-400 text-base">
