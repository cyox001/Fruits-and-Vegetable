    function startRound() {
      const modeItems = state.items.filter(item => item.category === state.mode);
      state.deck = shuffleArray(modeItems);
      state.collected = [];
      state.isTransitioning = false;
      dom.collectedPeek.innerHTML = '';
      updateProgress();
      showNextItem(true);
    }

    function updateProgress() {
      const total = state.collected.length + state.deck.length + (state.currentItem ? 1 : 0);
      dom.progressBadge.textContent = `${state.collected.length} / ${total}`;
    }

    function renderItemVisual(item) {
      if (item.svg) {
        return item.svg;
      }
      if (item.imageUrl) {
        return `<img src="${item.imageUrl}" alt="${item.name}" class="w-full h-full object-contain rounded-2xl pointer-events-none" />`;
      }
      return `<span class="text-6xl">🌱</span>`;
    }

    function showNextItem(isFirst = false) {
      resetCardPosition();

      if (state.deck.length === 0) {
        state.currentItem = null;
        dom.draggableCard.classList.add('hidden');
        updateProgress();
        triggerCelebration();
        return;
      }

      state.currentItem = state.deck.shift();
      updateProgress();

      dom.draggableCard.classList.remove('hidden', 'animate-pop-in');
      dom.cardArt.innerHTML = renderItemVisual(state.currentItem);
      dom.cardLabel.textContent = state.currentItem.name;

      // Force reflow for pop-in animation
      void dom.draggableCard.offsetWidth;
      dom.draggableCard.classList.add('animate-pop-in');
    }

    function addCollectedPeek(item) {
      const index = state.collected.length - 1;
      const mini = document.createElement('div');

      // Organized pyramid/tiered stacking inside the basket/crate opening:
      // Row 0 (front base row): 4 items tucked right behind the front rim/slat
      // Row 1 (second tier): 3 items nestled neatly above the gaps
      // Row 2 (top tier): 2 items crowning the stack
      // Further rows cycle cleanly so even large custom decks stay tidy!
      const tierCapacities = [4, 3, 2];
      let remaining = index;
      let tier = 0;
      while (remaining >= tierCapacities[tier % tierCapacities.length]) {
        remaining -= tierCapacities[tier % tierCapacities.length];
        tier++;
      }

      const colsInTier = tierCapacities[tier % tierCapacities.length];
      const col = remaining;

      // Horizontal centering within the container opening (24% to 76% of container width)
      const spacingX = 14.5; // percentage spacing between adjacent items
      const rowWidth = (colsInTier - 1) * spacingX;
      const centerX = 50 - rowWidth / 2 + col * spacingX;

      // Vertical stacking upwards inside the container opening (top % relative to 420x360 viewBox)
      // Front rim/top slat sits around top ~42% (y=152/360), so items sit at 27% and stack higher
      const baseTopPct = state.mode === 'fruit' ? 27.5 : 26.5;
      const tierOffsetPct = Math.min(tier, 4) * 6.8;
      const topPct = baseTopPct - tierOffsetPct;

      // Subtle natural tilt alternating left/right for a neat hand-packed look
      const tiltPattern = [-7, 5, -4, 7];
      const rot = tiltPattern[(col + tier) % tiltPattern.length];

      mini.className = 'absolute w-[21%] aspect-square animate-pop-in drop-shadow-md flex items-center justify-center';
      mini.style.left = `${centerX}%`;
      mini.style.top = `${topPct}%`;
      mini.style.marginLeft = '-10.5%'; // Center horizontally on left%
      // Higher tiers render behind lower front-row items for natural depth
      mini.style.zIndex = `${20 - tier}`;
      mini.style.transform = `rotate(${rot}deg)`;
      mini.innerHTML = renderItemVisual(item);
      dom.collectedPeek.appendChild(mini);
    }

    function spawnSparkles() {
      const containerRect = dom.dropContainer.getBoundingClientRect();
      const stageRect = dom.stage.getBoundingClientRect();
      const centerX = containerRect.left - stageRect.left + containerRect.width / 2;
      const centerY = containerRect.top - stageRect.top + containerRect.height * 0.42;

      const emojis = ['✨', '🌟', '🍃', '💛', '🌿'];
      for (let i = 0; i < 12; i++) {
        const p = document.createElement('div');
        p.className = 'particle text-2xl sm:text-3xl';
        p.textContent = emojis[i % emojis.length];
        const angle = (Math.PI * 2 * i) / 12 + (Math.random() * 0.3);
        const dist = 75 + Math.random() * 75;
        p.style.left = `${centerX}px`;
        p.style.top = `${centerY}px`;
        p.style.setProperty('--tx', `${Math.cos(angle) * dist}px`);
        p.style.setProperty('--ty', `${Math.sin(angle) * dist - 25}px`);
        p.style.setProperty('--rot', `${Math.random() * 240 - 120}deg`);
        dom.stage.appendChild(p);
        setTimeout(() => p.remove(), 900);
      }
    }

    function triggerCelebration() {
      SoundFX.roundWin();
      const count = state.collected.length;
      const label = state.mode === 'fruit'
        ? (count === 1 ? 'fruit' : 'fruits')
        : (count === 1 ? 'vegetable' : 'vegetables');

      dom.celebrationSubtitle.textContent = `You collected all ${count} ${label}!`;
      dom.btnSwitchOtherMode.textContent = state.mode === 'fruit' ? 'Try Veggies 🥕' : 'Try Fruits 🍎';
      dom.celebrationModal.classList.remove('hidden');
    }

    // ---------------------------------------------------------------------------
    // 6. SMOOTH POINTER DRAG & DROP (MOUSE + TOUCH)
    // ---------------------------------------------------------------------------
    let dragState = {
      active: false,
      startX: 0,
      startY: 0,
      currentX: 0,
      currentY: 0
    };

    function resetCardPosition() {
      dragState.active = false;
      dragState.currentX = 0;
      dragState.currentY = 0;
      dom.draggableCard.style.transition = 'transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1)';
      dom.draggableCard.style.transform = 'translate(0px, 0px) scale(1)';
      dom.draggableCard.classList.remove('is-dragging');
      dom.dropContainer.classList.remove('drop-zone-active');
    }

    function isOverDropZone() {
      const cardRect = dom.draggableCard.getBoundingClientRect();
      const dropRect = dom.dropContainer.getBoundingClientRect();

      const cardCenterX = cardRect.left + cardRect.width / 2;
      const cardCenterY = cardRect.top + cardRect.height / 2;

      const padX = dropRect.width * 0.08;
      const padY = dropRect.height * 0.08;

      return (
        cardCenterX >= dropRect.left - padX &&
        cardCenterX <= dropRect.right + padX &&
        cardCenterY >= dropRect.top - padY &&
        cardCenterY <= dropRect.bottom + padY
      );
    }

    function onPointerDown(e) {
      // Ignore if clicking the speaker button or transitioning
      if (e.target.closest('#btn-speak-word') || state.isTransitioning || !state.currentItem) return;

      SoundFX.init();
      SoundFX.pickup();

      dragState.active = true;
      dragState.startX = e.clientX;
      dragState.startY = e.clientY;

      dom.draggableCard.setPointerCapture(e.pointerId);
      dom.draggableCard.style.transition = 'none';
      dom.draggableCard.classList.add('is-dragging');
      dom.draggableCard.classList.remove('animate-pop-in');
    }

    function onPointerMove(e) {
      if (!dragState.active) return;

      const dx = e.clientX - dragState.startX;
      const dy = e.clientY - dragState.startY;
      dragState.currentX = dx;
      dragState.currentY = dy;

      const tilt = Math.max(-10, Math.min(10, dx * 0.03));
      dom.draggableCard.style.transform = `translate(${dx}px, ${dy}px) scale(1.07) rotate(${tilt}deg)`;

      if (isOverDropZone()) {
        dom.dropContainer.classList.add('drop-zone-active');
      } else {
        dom.dropContainer.classList.remove('drop-zone-active');
      }
    }

    function onPointerUp(e) {
      if (!dragState.active) return;
      dragState.active = false;
      dom.draggableCard.classList.remove('is-dragging');
      dom.dropContainer.classList.remove('drop-zone-active');

      if (isOverDropZone()) {
        handleSuccessfulDrop();
      } else {
        // If user barely moved (tapped the card), speak the word aloud!
        if (Math.hypot(dragState.currentX, dragState.currentY) < 10 && state.currentItem) {
          SoundFX.speak(state.currentItem.name);
        } else {
          SoundFX.snapBack();
        }
        resetCardPosition();
      }
    }

    function handleSuccessfulDrop() {
      if (!state.currentItem || state.isTransitioning) return;
      state.isTransitioning = true;

      const matchedItem = state.currentItem;
      state.collected.push(matchedItem);

      SoundFX.matchSuccess();
      SoundFX.speak(matchedItem.name);
      spawnSparkles();

      // Animate card shrinking into basket/crate
      dom.draggableCard.style.transition = 'transform 0.25s ease-in, opacity 0.22s ease-in';
      dom.draggableCard.style.transform = `translate(${dragState.currentX}px, ${dragState.currentY + 25}px) scale(0.25)`;
      dom.draggableCard.style.opacity = '0';

      // Bounce the basket/crate
      dom.dropContainer.classList.remove('animate-catch');
      void dom.dropContainer.offsetWidth;
      dom.dropContainer.classList.add('animate-catch');

      addCollectedPeek(matchedItem);

      setTimeout(() => {
        dom.draggableCard.style.opacity = '1';
        state.isTransitioning = false;
        showNextItem(false);
      }, 360);
    }

