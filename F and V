<script>
  // =========================================================================
  // 1. BUILT-IN PRODUCE DATA & LOCALSTORAGE PERSISTENCE
  // =========================================================================
  const DEFAULT_PRODUCE = [
    // Fruits
    { id: 'f1', name: 'Apple', category: 'fruit', emoji: '🍎', bg: '#fee2e2' },
    { id: 'f2', name: 'Banana', category: 'fruit', emoji: '🍌', bg: '#fef9c3' },
    { id: 'f3', name: 'Strawberry', category: 'fruit', emoji: '🍓', bg: '#ffe4e6' },
    { id: 'f4', name: 'Orange', category: 'fruit', emoji: '🍊', bg: '#ffedd5' },
    { id: 'f5', name: 'Grapes', category: 'fruit', emoji: '🍇', bg: '#f3e8ff' },
    { id: 'f6', name: 'Watermelon', category: 'fruit', emoji: '🍉', bg: '#dcfce7' },
    // Vegetables
    { id: 'v1', name: 'Carrot', category: 'vegetable', emoji: '🥕', bg: '#ffedd5' },
    { id: 'v2', name: 'Broccoli', category: 'vegetable', emoji: '🥦', bg: '#dcfce7' },
    { id: 'v3', name: 'Corn', category: 'vegetable', emoji: '🌽', bg: '#fef9c3' },
    { id: 'v4', name: 'Eggplant', category: 'vegetable', emoji: '🍆', bg: '#f3e8ff' },
    { id: 'v5', name: 'Bell Pepper', category: 'vegetable', emoji: '🫑', bg: '#dcfce7' },
    { id: 'v6', name: 'Cucumber', category: 'vegetable', emoji: '🥒', bg: '#d1fae5' }
  ];

  const STORAGE_KEY = 'sunny_stand_produce_v1';
  let produceItems = [];

  function loadProduceItems() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        const parsed = JSON.parse(saved);
        if (Array.isArray(parsed) && parsed.length > 0) {
          produceItems = parsed;
          updateCategoryCounts();
          return;
        }
      }
    } catch (e) {
      console.warn('Could not read localStorage:', e);
    }
    produceItems = [...DEFAULT_PRODUCE];
    updateCategoryCounts();
  }

  function saveProduceItems() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(produceItems));
    } catch (e) {
      showToast('Storage full! Try smaller image files.');
    }
    updateCategoryCounts();
  }

  function updateCategoryCounts() {
    const fruits = produceItems.filter(i => i.category === 'fruit').length;
    const vegs = produceItems.filter(i => i.category === 'vegetable').length;
    document.getElementById('fruit-count-label').textContent = fruits;
    document.getElementById('veg-count-label').textContent = vegs;
    document.getElementById('total-items-count').textContent = produceItems.length;
  }

  // =========================================================================
  // 2. WEB AUDIO API SOUND SYNTHESIZER (Offline, Zero External Audio Files)
  // =========================================================================
  let audioCtx = null;
  let soundEnabled = true;

  function ensureAudio() {
    if (!audioCtx) {
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      audioCtx = new AudioContext();
    }
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
  }

  function toggleSound() {
    soundEnabled = !soundEnabled;
    document.getElementById('sound-icon').textContent = soundEnabled ? '🔊' : '🔇';
    if (soundEnabled) {
      ensureAudio();
      playPopSound();
    }
  }

  function playPopSound() {
    if (!soundEnabled) return;
    ensureAudio();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(520, audioCtx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(780, audioCtx.currentTime + 0.09);
    gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.1);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + 0.1);
  }

  function playTickSound(secondsLeft) {
    if (!soundEnabled) return;
    ensureAudio();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'triangle';
    // Higher pitch on last 2 seconds
    const freq = secondsLeft <= 2 ? 880 : 620;
    osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
    gain.gain.setValueAtTime(0.18, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.12);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + 0.12);
  }

  function playCorrectSound() {
    if (!soundEnabled) return;
    ensureAudio();
    // Cheerful ascending major arpeggio fanfare (C5 - E5 - G5 - C6)
    const notes = [523.25, 659.25, 783.99, 1046.50];
    notes.forEach((freq, idx) => {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'triangle';
      const startTime = audioCtx.currentTime + idx * 0.11;
      osc.frequency.setValueAtTime(freq, startTime);
      gain.gain.setValueAtTime(0.28, startTime);
      gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.35);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(startTime);
      osc.stop(startTime + 0.36);
    });
  }

  function playIncorrectSound() {
    if (!soundEnabled) return;
    ensureAudio();
    // Gentle descending two-tone "boing / try again"
    const notes = [330, 246.94];
    notes.forEach((freq, idx) => {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      const startTime = audioCtx.currentTime + idx * 0.18;
      osc.frequency.setValueAtTime(freq, startTime);
      osc.frequency.linearRampToValueAtTime(freq * 0.92, startTime + 0.25);
      gain.gain.setValueAtTime(0.25, startTime);
      gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.28);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(startTime);
      osc.stop(startTime + 0.3);
    });
  }

  // =========================================================================
  // 3. WEBCAM & MOTION / SIDE DETECTION ENGINE
  // =========================================================================
  let cameraActive = false;
  let videoStream = null;
  let prevFrameData = null;
  let detectedSide = 'center'; // 'left' | 'right' | 'center'
  let smoothedBalance = 0; // -1 (full left) to +1 (full right)
  let motionLoopId = null;

  const videoEl = document.getElementById('webcam-video');
  const motionCanvas = document.getElementById('motion-canvas');
  const motionCtx = motionCanvas.getContext('2d', { willReadFrequently: true });

  async function initCamera() {
    try {
      videoStream = await navigator.mediaDevices.getUserMedia({
        video: { width: { ideal: 640 }, height: { ideal: 360 }, facingMode: 'user' },
        audio: false
      });
      videoEl.srcObject = videoStream;
      await videoEl.play();
      cameraActive = true;
      document.getElementById('no-camera-bg').classList.add('hidden');
      videoEl.classList.remove('hidden');
      updateCameraButtonUI(true);
      startMotionTracking();
    } catch (err) {
      console.warn('Camera unavailable or permission denied:', err);
      cameraActive = false;
      videoEl.classList.add('hidden');
      document.getElementById('no-camera-bg').classList.remove('hidden');
      updateCameraButtonUI(false);
    }
  }

  function stopCamera() {
    if (videoStream) {
      videoStream.getTracks().forEach(t => t.stop());
      videoStream = null;
    }
    cameraActive = false;
    if (motionLoopId) cancelAnimationFrame(motionLoopId);
    videoEl.classList.add('hidden');
    document.getElementById('no-camera-bg').classList.remove('hidden');
    updateCameraButtonUI(false);
  }

  function toggleCamera() {
    if (cameraActive) {
      stopCamera();
      showToast('Camera paused — click cards or use Left/Right keys');
    } else {
      initCamera();
    }
  }

  function updateCameraButtonUI(isOn) {
    const icon = document.getElementById('cam-status-icon');
    const text = document.getElementById('cam-status-text');
    const btn = document.getElementById('btn-cam-toggle');
    if (isOn) {
      icon.textContent = '📷';
      text.textContent = 'Camera On';
      btn.classList.remove('bg-slate-200', 'text-slate-600', 'border-slate-400');
      btn.classList.add('bg-sky-100', 'text-sky-900', 'border-sky-700');
    } else {
      icon.textContent = '🚫';
      text.textContent = 'Camera Off';
      btn.classList.add('bg-slate-200', 'text-slate-600', 'border-slate-400');
      btn.classList.remove('bg-sky-100', 'text-sky-900', 'border-sky-700');
    }
  }

  function startMotionTracking() {
    const w = motionCanvas.width;
    const h = motionCanvas.height;

    function processFrame() {
      if (!cameraActive) return;

      if (videoEl.readyState >= 2) {
        // Draw mirrored image to match user screen perspective
        motionCtx.save();
        motionCtx.scale(-1, 1);
        motionCtx.drawImage(videoEl, -w, 0, w, h);
        motionCtx.restore();

        const currentFrame = motionCtx.getImageData(0, 0, w, h).data;

        if (prevFrameData) {
          let leftMotion = 0;
          let rightMotion = 0;
          const midX = w / 2;

          for (let y = 0; y < h; y += 2) {
            for (let x = 0; x < w; x += 2) {
              const i = (y * w + x) * 4;
              const diff =
                Math.abs(currentFrame[i] - prevFrameData[i]) +
                Math.abs(currentFrame[i + 1] - prevFrameData[i + 1]) +
                Math.abs(currentFrame[i + 2] - prevFrameData[i + 2]);

              if (diff > 55) {
                if (x < midX) leftMotion += diff;
                else rightMotion += diff;
              }
            }
          }

          const totalMotion = leftMotion + rightMotion;
          if (totalMotion > 1800) {
            // Compute normalized horizontal motion bias (-1 = Left, +1 = Right)
            const rawBalance = (rightMotion - leftMotion) / totalMotion;
            smoothedBalance = smoothedBalance * 0.72 + rawBalance * 0.28;

            if (smoothedBalance < -0.14) {
              setDetectedSide('left');
            } else if (smoothedBalance > 0.14) {
              setDetectedSide('right');
            }
          }
        }

        prevFrameData = new Uint8ClampedArray(currentFrame);
      }

      motionLoopId = requestAnimationFrame(processFrame);
    }

    motionLoopId = requestAnimationFrame(processFrame);
  }

  function setDetectedSide(side) {
    if (roundState !== 'playing') return;
    detectedSide = side;

    const leftZone = document.getElementById('zone-left-highlight');
    const rightZone = document.getElementById('zone-right-highlight');
    const cardLeft = document.getElementById('card-left');
    const cardRight = document.getElementById('card-right');
    const badge = document.getElementById('detected-side-text');

    leftZone.classList.remove('bg-sky-400/30');
    rightZone.classList.remove('bg-purple-400/30');
    cardLeft.classList.remove('active-side');
    cardRight.classList.remove('active-side');

    if (side === 'left') {
      leftZone.classList.add('bg-sky-400/30');
      cardLeft.classList.add('active-side');
      badge.textContent = '◀ LEFT SIDE';
      badge.className = 'px-3 py-0.5 rounded-full bg-sky-400 text-slate-950 uppercase';
    } else if (side === 'right') {
      rightZone.classList.add('bg-purple-400/30');
      cardRight.classList.add('active-side');
      badge.textContent = 'RIGHT SIDE ▶';
      badge.className = 'px-3 py-0.5 rounded-full bg-purple-400 text-white uppercase';
    } else {
      badge.textContent = 'Center (Step Left or Right!)';
      badge.className = 'px-3 py-0.5 rounded-full bg-amber-500 text-slate-950 uppercase';
    }
  }

  // Fallback click or keyboard control
  function manualSelectSide(side) {
    if (roundState !== 'playing') return;
    playPopSound();
    setDetectedSide(side);
  }

  window.addEventListener('keydown', (e) => {
    if (roundState !== 'playing') return;
    if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {
      manualSelectSide('left');
    } else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {
      manualSelectSide('right');
    }
  });

  // =========================================================================
  // 4. GAME STATE, ROUND LOGIC & 5-SECOND TIMER
  // =========================================================================
  let currentMode = 'fruit'; // 'fruit' | 'vegetable'
  let roundState = 'idle'; // 'idle' | 'ready' | 'playing' | 'result'
  let correctSide = 'left'; // 'left' | 'right'
  let currentTargetItem = null;
  let currentDistractorItem = null;
  let score = 0;
  let roundsPlayed = 0;
  let targetDeckIndex = 0;

  let timerInterval = null;
  const ROUND_DURATION_MS = 5000;
  let roundStartTime = 0;
  let lastWholeSecond = 5;

  function showScreen(screenId) {
    ['screen-select', 'screen-ready', 'screen-play'].forEach(id => {
      document.getElementById(id).classList.add('hidden');
    });
    document.getElementById(screenId).classList.remove('hidden');
  }

  function updateModeSwitcherUI() {
    const btnFruit = document.getElementById('btn-switch-fruit');
    const btnVeg = document.getElementById('btn-switch-veg');

    if (currentMode === 'fruit') {
      btnFruit.className = 'btn-preschool px-4 py-1.5 rounded-xl font-extrabold text-base flex items-center gap-1.5 transition-colors bg-orange-500 text-white shadow';
      btnVeg.className = 'btn-preschool px-4 py-1.5 rounded-xl font-extrabold text-base flex items-center gap-1.5 transition-colors text-amber-100 hover:bg-white/10';
    } else {
      btnVeg.className = 'btn-preschool px-4 py-1.5 rounded-xl font-extrabold text-base flex items-center gap-1.5 transition-colors bg-green-600 text-white shadow';
      btnFruit.className = 'btn-preschool px-4 py-1.5 rounded-xl font-extrabold text-base flex items-center gap-1.5 transition-colors text-amber-100 hover:bg-white/10';
    }
  }

  function goHome() {
    clearInterval(timerInterval);
    roundState = 'idle';
    document.getElementById('score-badge').classList.add('hidden');
    showScreen('screen-select');
  }

  function selectCategory(mode) {
    playPopSound();
    currentMode = mode;
    targetDeckIndex = 0;
    updateModeSwitcherUI();

    const readyBadge = document.getElementById('ready-badge');
    const readyEmoji = document.getElementById('ready-emoji');
    const readyInstruction = document.getElementById('ready-instruction');

    if (mode === 'fruit') {
      readyBadge.textContent = '🍎 Fruits Mode';
      readyBadge.className = 'px-5 py-1.5 rounded-full text-white font-black text-lg uppercase tracking-wider mb-4 bg-orange-500';
      readyEmoji.textContent = '🍓';
      readyInstruction.textContent = 'Choose the fruit.';
    } else {
      readyBadge.textContent = '🥦 Vegetables Mode';
      readyBadge.className = 'px-5 py-1.5 rounded-full text-white font-black text-lg uppercase tracking-wider mb-4 bg-green-600';
      readyEmoji.textContent = '🥕';
      readyInstruction.textContent = 'Choose the vegetable.';
    }

    roundState = 'ready';
    showScreen('screen-ready');
  }

  function switchMode(newMode) {
    playPopSound();
    clearInterval(timerInterval);
    selectCategory(newMode);
  }

  function renderProduceMedia(container, item) {
    if (item.imageDataUrl) {
      container.innerHTML = `<img src="${item.imageDataUrl}" alt="${item.name}" class="w-full h-full object-contain rounded-xl drop-shadow" />`;
    } else {
      container.style.backgroundColor = item.bg || '#fef3c7';
      container.innerHTML = `<span class="text-8xl sm:text-9xl select-none drop-shadow-sm">${item.emoji || '🧺'}</span>`;
    }
  }

  function startRound() {
    playPopSound();
    ensureAudio();

    const fruits = produceItems.filter(i => i.category === 'fruit');
    const veggies = produceItems.filter(i => i.category === 'vegetable');

    if (fruits.length === 0 || veggies.length === 0) {
      showToast('Please ensure at least 1 Fruit and 1 Vegetable picture exist!');
      openSettings();
      return;
    }

    // Start webcam if not already running
    if (!cameraActive && !videoStream) {
      initCamera();
    }

    // Select target item sequentially so "Next" cycles cleanly through all pictures
    const targetPool = currentMode === 'fruit' ? fruits : veggies;
    const distractorPool = currentMode === 'fruit' ? veggies : fruits;

    currentTargetItem = targetPool[targetDeckIndex % targetPool.length];
    targetDeckIndex++;

    currentDistractorItem = distractorPool[Math.floor(Math.random() * distractorPool.length)];

    // Randomly place target on Left or Right
    correctSide = Math.random() < 0.5 ? 'left' : 'right';
    const leftItem = correctSide === 'left' ? currentTargetItem : currentDistractorItem;
    const rightItem = correctSide === 'right' ? currentTargetItem : currentDistractorItem;

    // Reset Card Styles
    const cardLeft = document.getElementById('card-left');
    const cardRight = document.getElementById('card-right');
    cardLeft.className = 'produce-card w-full max-w-[330px] aspect-[4/4.2] p-4 sm:p-5 flex flex-col items-center justify-between cursor-pointer relative';
    cardRight.className = 'produce-card w-full max-w-[330px] aspect-[4/4.2] p-4 sm:p-5 flex flex-col items-center justify-between cursor-pointer relative';

    renderProduceMedia(document.getElementById('card-left-media'), leftItem);
    document.getElementById('card-left-label').textContent = leftItem.name;

    renderProduceMedia(document.getElementById('card-right-media'), rightItem);
    document.getElementById('card-right-label').textContent = rightItem.name;

    // Update HUD Instruction
    document.getElementById('hud-mode-icon').textContent = currentMode === 'fruit' ? '🍎' : '🥦';
    document.getElementById('hud-instruction').textContent =
      currentMode === 'fruit' ? 'Choose the fruit.' : 'Choose the vegetable.';

    // Hide Result Overlay & Show Score
    document.getElementById('result-overlay').classList.add('hidden');
    document.getElementById('score-badge').classList.remove('hidden');

    // Reset Side Detection
    roundState = 'playing';
    detectedSide = 'center';
    smoothedBalance = 0;
    setDetectedSide('center');

    showScreen('screen-play');
    startFiveSecondCountdown();
  }

  function startFiveSecondCountdown() {
    clearInterval(timerInterval);
    roundStartTime = performance.now();
    lastWholeSecond = 5;

    const timerCircle = document.getElementById('timer-circle');
    const timerBar = document.getElementById('timer-bar');

    timerCircle.textContent = '5';
    timerCircle.classList.remove('bg-red-600', 'timer-urgent');
    timerCircle.classList.add('bg-amber-500');
    timerBar.style.width = '100%';

    timerInterval = setInterval(() => {
      const elapsed = performance.now() - roundStartTime;
      const remainingMs = Math.max(0, ROUND_DURATION_MS - elapsed);
      const pct = (remainingMs / ROUND_DURATION_MS) * 100;
      const wholeSec = Math.ceil(remainingMs / 1000);

      timerBar.style.width = `${pct}%`;

      if (wholeSec !== lastWholeSecond && wholeSec > 0) {
        lastWholeSecond = wholeSec;
        timerCircle.textContent = wholeSec;
        playTickSound(wholeSec);

        if (wholeSec <= 2) {
          timerCircle.classList.remove('bg-amber-500');
          timerCircle.classList.add('bg-red-600', 'timer-urgent');
        }
      }

      if (remainingMs <= 0) {
        clearInterval(timerInterval);
        timerCircle.textContent = '0';
        evaluateRound();
      }
    }, 50);
  }

  function evaluateRound() {
    roundState = 'result';
    roundsPlayed++;

    const isCorrect = detectedSide === correctSide;
    if (isCorrect) score++;

    document.getElementById('score-count').textContent = score;
    document.getElementById('round-total').textContent = roundsPlayed;

    // Highlight Correct vs Wrong Cards
    const cardLeft = document.getElementById('card-left');
    const cardRight = document.getElementById('card-right');

    if (correctSide === 'left') {
      cardLeft.classList.add('correct-card');
      cardRight.classList.add('wrong-card');
    } else {
      cardRight.classList.add('correct-card');
      cardLeft.classList.add('wrong-card');
    }

    // Configure Result Modal
    const resultBox = document.getElementById('result-box');
    const resultEmoji = document.getElementById('result-emoji');
    const resultTitle = document.getElementById('result-title');
    const resultSubtitle = document.getElementById('result-subtitle');
    const nextModeName = document.getElementById('btn-next-mode-name');

    nextModeName.textContent = currentMode === 'fruit' ? 'Vegetables' : 'Fruits';

    const categoryWord = currentMode === 'fruit' ? 'fruit' : 'vegetable';

    if (isCorrect) {
      playCorrectSound();
      launchConfetti();
      resultBox.className = 'bg-white border-8 border-green-500 rounded-[40px] px-8 py-6 sm:px-12 sm:py-8 max-w-xl w-full text-center shadow-2xl flex flex-col items-center';
      resultEmoji.textContent = '🌟🎉';
      resultTitle.textContent = 'Awesome Job!';
      resultTitle.className = 'text-4xl sm:text-5xl font-black text-green-600 mb-2';
      resultSubtitle.textContent = `Yes! ${currentTargetItem.name} is a ${categoryWord}!`;
    } else {
      playIncorrectSound();
      resultBox.className = 'bg-white border-8 border-amber-500 rounded-[40px] px-8 py-6 sm:px-12 sm:py-8 max-w-xl w-full text-center shadow-2xl flex flex-col items-center';
      resultEmoji.textContent = '💪😊';
      resultTitle.textContent = detectedSide === 'center' ? "Time's Up!" : 'Nice Try!';
      resultTitle.className = 'text-4xl sm:text-5xl font-black text-amber-600 mb-2';
      resultSubtitle.textContent = `The ${currentTargetItem.name} (${correctSide.toUpperCase()} side) is the ${categoryWord}!`;
    }

    setTimeout(() => {
      document.getElementById('result-overlay').classList.remove('hidden');
    }, 450);
  }

  function nextRound() {
    startRound();
  }

  // =========================================================================
  // 5. CUSTOM PICTURE UPLOADER & SETTINGS MODAL ("F and V game")
  // =========================================================================
  function openSettings() {
    playPopSound();
    renderSettingsGrid();
    document.getElementById('settings-modal').classList.remove('hidden');
  }

  function closeSettings() {
    playPopSound();
    document.getElementById('settings-modal').classList.add('hidden');
  }

  function handleImageUpload(event) {
    const files = Array.from(event.target.files || []);
    if (!files.length) return;

    const category = document.getElementById('upload-category').value;
    const customLabelInput = document.getElementById('upload-label').value.trim();

    let processedCount = 0;

    files.forEach((file) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        // Resize image gently on an offscreen canvas so localStorage stays fast & roomy
        const img = new Image();
        img.onload = () => {
          const maxDim = 420;
          let w = img.width;
          let h = img.height;
          if (w > maxDim || h > maxDim) {
            if (w > h) {
              h = Math.round((h * maxDim) / w);
              w = maxDim;
            } else {
              w = Math.round((w * maxDim) / h);
              h = maxDim;
            }
          }
          const c = document.createElement('canvas');
          c.width = w;
          c.height = h;
          const ctx = c.getContext('2d');
          ctx.drawImage(img, 0, 0, w, h);
          const compressedUrl = c.toDataURL('image/png', 0.88);

          // Clean filename into readable label if user didn't type one
          const cleanFileName = file.name
            .replace(/\.[^/.]+$/, '')
            .replace(/[-_]+/g, ' ')
            .replace(/\b\w/g, l => l.toUpperCase());

          const finalLabel = (files.length === 1 && customLabelInput) ? customLabelInput : cleanFileName;

          produceItems.unshift({
            id: 'custom_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
            name: finalLabel || (category === 'fruit' ? 'Fruit' : 'Vegetable'),
            category: category,
            imageDataUrl: compressedUrl
          });

          processedCount++;
          if (processedCount === files.length) {
            saveProduceItems();
            renderSettingsGrid();
            document.getElementById('upload-label').value = '';
            event.target.value = '';
            showToast(`Added ${files.length} picture${files.length > 1 ? 's' : ''}!`);
          }
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    });
  }

  function deleteProduceItem(id) {
    playPopSound();
    produceItems = produceItems.filter(item => item.id !== id);
    saveProduceItems();
    renderSettingsGrid();
  }

  function resetDefaultItems() {
    playPopSound();
    produceItems = [...DEFAULT_PRODUCE];
    saveProduceItems();
    renderSettingsGrid();
    showToast('Restored default fruits & vegetables!');
  }

  function renderSettingsGrid() {
    const grid = document.getElementById('custom-items-grid');
    grid.innerHTML = '';

    produceItems.forEach(item => {
      const card = document.createElement('div');
      card.className = 'bg-white border-2 border-amber-300 rounded-2xl p-2.5 flex flex-col items-center relative shadow-sm';

      const badgeColor = item.category === 'fruit' ? 'bg-orange-500' : 'bg-green-600';
      const badgeLabel = item.category === 'fruit' ? 'Fruit' : 'Veg';

      const mediaHtml = item.imageDataUrl
        ? `<img src="${item.imageDataUrl}" alt="${item.name}" class="w-16 h-16 object-contain rounded-lg" />`
        : `<span class="text-5xl leading-none py-1">${item.emoji}</span>`;

      card.innerHTML = `
        <span class="absolute top-1.5 left-1.5 ${badgeColor} text-white text-[10px] font-black px-2 py-0.5 rounded-full uppercase">
          ${badgeLabel}
        </span>
        <button onclick="deleteProduceItem('${item.id}')" class="absolute top-1.5 right-1.5 bg-red-100 hover:bg-red-500 hover:text-white text-red-700 w-6 h-6 rounded-full text-xs font-black flex items-center justify-center transition-colors" title="Remove">
          ✕
        </button>
        <div class="mt-4 mb-1.5 flex items-center justify-center h-16">
          ${mediaHtml}
        </div>
        <div class="font-extrabold text-slate-800 text-sm text-center truncate w-full">${item.name}</div>
      `;
      grid.appendChild(card);
    });
  }

  // =========================================================================
  // 6. FULLSCREEN, TOAST & CELEBRATION CONFETTI
  // =========================================================================
  function toggleFullscreen() {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(() => {});
    } else {
      document.exitFullscreen().catch(() => {});
    }
  }

  let toastTimeout = null;
  function showToast(msg) {
    const el = document.getElementById('toast-msg');
    el.textContent = msg;
    el.classList.remove('hidden');
    clearTimeout(toastTimeout);
    toastTimeout = setTimeout(() => el.classList.add('hidden'), 3000);
  }

  function launchConfetti() {
    const canvas = document.getElementById('confetti-canvas');
    const stage = document.getElementById('stage-wrapper');
    canvas.width = stage.clientWidth;
    canvas.height = stage.clientHeight;
    const ctx = canvas.getContext('2d');

    const colors = ['#ef4444', '#f59e0b', '#22c55e', '#3b82f6', '#a855f7', '#ec4899'];
    const particles = Array.from({ length: 75 }, () => ({
      x: canvas.width * 0.5 + (Math.random() - 0.5) * 260,
      y: canvas.height * 0.45,
      vx: (Math.random() - 0.5) * 14,
      vy: -Math.random() * 12 - 4,
      size: Math.random() * 10 + 6,
      color: colors[Math.floor(Math.random() * colors.length)],
      rot: Math.random() * 360,
      vRot: (Math.random() - 0.5) * 12
    }));

    let frames = 0;
    function step() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach(p => {
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.42; // gravity
        p.rot += p.vRot;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate((p.rot * Math.PI) / 180);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.65);
        ctx.restore();
      });
      frames++;
      if (frames < 95) {
        requestAnimationFrame(step);
      } else {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
    }
    requestAnimationFrame(step);
  }

  // Initialize on Page Load
  window.onload = function () {
    loadProduceItems();
    updateModeSwitcherUI();
  };
</script>
