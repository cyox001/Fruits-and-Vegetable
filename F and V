    // Resize image file to lightweight PNG data URL
    function resizeImageFileToDataUrl(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onerror = () => reject(new Error('Failed to read image file'));
        reader.onload = (event) => {
          const img = new Image();
          img.onerror = () => reject(new Error('Invalid image file'));
          img.onload = () => {
            const canvas = document.createElement('canvas');
            const maxDim = 280;
            let w = img.width;
            let h = img.height;
            if (w > maxDim || h > maxDim) {
              if (w > h) {
                h = Math.round((h * maxDim) / w);
                w = maxDim;
              } else {
                w = Math.round((w * maxDim) / h);
                h = maxDim;
              }
            }
            canvas.width = w;
            canvas.height = h;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, w, h);
            resolve(canvas.toDataURL('image/png'));
          };
          img.src = event.target.result;
        };
        reader.readAsDataURL(file);
      });
    }

    // Extract clean beginner vocabulary word from filename (e.g. "green_apple-01.png" -> "green apple")
    function cleanWordFromFilename(filename) {
      const withoutExt = filename.replace(/\.[^/.]+$/, '');
      const cleaned = withoutExt
        .replace(/[_-]+/g, ' ')
        .replace(/\d+/g, '')
        .replace(/\s+/g, ' ')
        .trim()
        .toLowerCase();
      return cleaned.slice(0, 22);
    }

