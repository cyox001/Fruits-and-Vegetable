    dom.btnCopyFolderPath.addEventListener('click', () => {
      const pathVal = dom.inputFolderPath.value.trim() || DEFAULT_FOLDER_PATH;
      dom.inputFolderPath.select();
      try {
        document.execCommand('copy');
        showToast(`Copied path: ${pathVal}`);
      } catch (err) {
        showToast(`Folder path: ${pathVal}`);
      }
      window.getSelection?.().removeAllRanges?.();
    });

    // Handle Batch Folder / Files Import ("F and V game" folder)
    dom.inputFolderPicker.addEventListener('change', async (e) => {
      const files = Array.from(e.target.files || []).filter(f => f.type.startsWith('image/'));
      if (files.length === 0) {
        showToast('No image files found in selected folder.');
        return;
      }

      // Update displayed folder path if browser provides webkitRelativePath
      const firstRelPath = files[0].webkitRelativePath;
      if (firstRelPath && firstRelPath.includes('/')) {
        const topFolder = firstRelPath.split('/')[0];
        if (topFolder) {
          const updatedPath = topFolder.toLowerCase().includes('downloads')
            ? topFolder
            : `Downloads/${topFolder}`;
          dom.inputFolderPath.value = updatedPath;
          saveFolderPath(updatedPath);
        }
      }

      const selectedCategory = dom.addItemForm.querySelector('input[name="item-category"]:checked').value;
      let addedCount = 0;

      for (const file of files) {
        const wordName = cleanWordFromFilename(file.name);
        if (!wordName) continue;

        try {
          const dataUrl = await resizeImageFileToDataUrl(file);
          state.items.push({
            id: `folder-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
            name: wordName,
            category: selectedCategory,
            isDefault: false,
            imageUrl: dataUrl
          });
          addedCount++;
        } catch (err) {
          // Skip unreadable files
        }
      }

      dom.inputFolderPicker.value = '';

      if (addedCount > 0) {
        saveItems();
        renderSettingsLists();
        SoundFX.matchSuccess();
        const catLabel = selectedCategory === 'fruit' ? 'Fruits' : 'Vegetables';
        dom.formFeedback.textContent = `Imported ${addedCount} picture${addedCount === 1 ? '' : 's'} into ${catLabel}!`;
        dom.formFeedback.className = 'text-xs font-bold text-emerald-700 min-h-[18px] mb-1.5';
        showToast(`Imported ${addedCount} image${addedCount === 1 ? '' : 's'} into ${catLabel}!`);
      }
    });

    // Handle Individual Image Upload FileReader
    dom.inputImageFile.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      // Auto-fill word name if currently empty
      if (!dom.inputWordName.value.trim()) {
        const suggested = cleanWordFromFilename(file.name);
        if (suggested) dom.inputWordName.value = suggested;
      }

      try {
        pendingUploadDataUrl = await resizeImageFileToDataUrl(file);
        dom.uploadPreview.src = pendingUploadDataUrl;
        dom.uploadPreview.classList.remove('hidden');
        dom.uploadPrompt.innerHTML = `<span class="text-emerald-700 font-bold">✓ Ready! Click to change</span>`;
      } catch (err) {
        showToast('Could not load image file.');
      }
    });

    // Handle Add New Item Submit
    dom.addItemForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const rawName = dom.inputWordName.value.trim().toLowerCase();
      const category = dom.addItemForm.querySelector('input[name="item-category"]:checked').value;

      if (!rawName) {
        dom.formFeedback.textContent = 'Please type a word name.';
        dom.formFeedback.className = 'text-xs font-bold text-rose-600 min-h-[18px] mb-1.5';
        return;
      }
      if (!pendingUploadDataUrl) {
        dom.formFeedback.textContent = 'Please choose an image file.';
        dom.formFeedback.className = 'text-xs font-bold text-rose-600 min-h-[18px] mb-1.5';
        return;
      }

      const newItem = {
        id: `custom-${Date.now()}`,
        name: rawName,
        category,
        isDefault: false,
        imageUrl: pendingUploadDataUrl
      };

      state.items.push(newItem);
      saveItems();
      renderSettingsLists();

      // Reset form inputs
      dom.inputWordName.value = '';
      dom.inputImageFile.value = '';
      pendingUploadDataUrl = null;
      dom.uploadPreview.classList.add('hidden');
      dom.uploadPrompt.innerHTML = `🖼️ Choose single image file<br/><span class="text-[11px] font-normal text-slate-500">(PNG, JPG, SVG, WebP)</span>`;

      dom.formFeedback.textContent = `Added "${rawName}" to ${category}s!`;
      dom.formFeedback.className = 'text-xs font-bold text-emerald-700 min-h-[18px] mb-1.5';
      SoundFX.matchSuccess();
    });

    // Delegate Delete Item Clicks
    dom.settingsModal.addEventListener('click', (e) => {
      const delBtn = e.target.closest('[data-delete-id]');
      if (!delBtn) return;

      const id = delBtn.getAttribute('data-delete-id');
      const target = state.items.find(i => i.id === id);
      if (!target) return;

      const sameCatCount = state.items.filter(i => i.category === target.category).length;
      if (sameCatCount <= 1) {
        showToast(`Keep at least 1 ${target.category} in the garden!`);
        return;
      }

      state.items = state.items.filter(i => i.id !== id);
      saveItems();
      renderSettingsLists();
      SoundFX.snapBack();
    });

    // Reset Defaults (Two-click safety without confirm())
    let resetConfirmPending = false;
    let resetTimer = null;
    dom.btnResetDefaults.addEventListener('click', () => {
      if (!resetConfirmPending) {
        resetConfirmPending = true;
        dom.btnResetDefaults.textContent = 'Click again to confirm';
        dom.btnResetDefaults.classList.add('bg-rose-500', 'text-white');
        resetTimer = setTimeout(() => {
          resetConfirmPending = false;
          dom.btnResetDefaults.textContent = 'Reset Defaults';
          dom.btnResetDefaults.classList.remove('bg-rose-500', 'text-white');
        }, 3000);
      } else {
        clearTimeout(resetTimer);
        resetConfirmPending = false;
        dom.btnResetDefaults.textContent = 'Reset Defaults';
        dom.btnResetDefaults.classList.remove('bg-rose-500', 'text-white');

        state.items = JSON.parse(JSON.stringify(DEFAULT_ITEMS));
        saveItems();
        saveFolderPath(DEFAULT_FOLDER_PATH);
        dom.inputFolderPath.value = DEFAULT_FOLDER_PATH;
        renderSettingsLists();
        SoundFX.matchSuccess();
        showToast('Garden restored to default fruits & vegetables!');
      }
    });

    // ---------------------------------------------------------------------------
    // 8. WIRE UP UI CONTROLS & INITIALIZE
    // ---------------------------------------------------------------------------
    dom.btnFruit.addEventListener('click', () => {
      SoundFX.pickup();
      setMode('fruit');
    });

    dom.btnVeg.addEventListener('click', () => {
      SoundFX.pickup();
      setMode('vegetable');
    });

    dom.btnSpeakWord.addEventListener('click', (e) => {
      e.stopPropagation();
      if (state.currentItem) {
        SoundFX.speak(state.currentItem.name);
      }
    });

    dom.btnSound.addEventListener('click', () => {
      SoundFX.muted = !SoundFX.muted;
      dom.iconSoundOn.classList.toggle('hidden', SoundFX.muted);
      dom.iconSoundOff.classList.toggle('hidden', !SoundFX.muted);
      if (!SoundFX.muted) SoundFX.pickup();
    });

    dom.btnSettings.addEventListener('click', () => {
      SoundFX.pickup();
      openSettings();
    });

    dom.btnCloseSettings.addEventListener('click', () => {
      SoundFX.pickup();
      closeSettings();
    });

    dom.btnFullscreen.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        dom.stage.requestFullscreen?.().catch(() => {});
      } else {
        document.exitFullscreen?.().catch(() => {});
      }
    });

    dom.btnPlayAgain.addEventListener('click', () => {
      SoundFX.pickup();
      dom.celebrationModal.classList.add('hidden');
      startRound();
    });

    dom.btnSwitchOtherMode.addEventListener('click', () => {
      SoundFX.pickup();
      setMode(state.mode === 'fruit' ? 'vegetable' : 'fruit');
    });

    // Pointer Drag Listeners on Vocabulary Card
    dom.draggableCard.addEventListener('pointerdown', onPointerDown);
    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', onPointerUp);
    window.addEventListener('pointercancel', onPointerUp);

    // Boot Game
    window.addEventListener('DOMContentLoaded', () => {
      loadItems();
      loadFolderPath();
      setMode('fruit');
    });
  </script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sunny Produce Stand — Fruits & Veggies Motion Game</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@700;800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --wood-dark: #7c3f1d;
      --wood-mid: #a45729;
      --wood-light: #d98a4e;
      --awning-red: #ef4444;
      --awning-cream: #fffbeb;
      --fruit-accent: #f97316;
      --veg-accent: #16a34a;
    }

    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
    }

    body {
      margin: 0;
      padding: 0;
      background: #1e293b;
      font-family: 'Fredoka', sans-serif;
      overflow: hidden;
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* 16:9 Responsive Stage Container */
    #stage-wrapper {
      width: 100vw;
      height: 100vh;
      max-width: 177.78vh;
      max-height: 56.25vw;
      position: relative;
      overflow: hidden;
      background: linear-gradient(180deg, #bae6fd 0%, #e0f2fe 55%, #fde68a 100%);
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.55);
      display: flex;
      flex-direction: column;
    }

    /* Striped Market Awning */
    .market-awning {
      background: repeating-linear-gradient(
        90deg,
        #ef4444 0px,
        #ef4444 56px,
        #fffbeb 56px,
        #fffbeb 112px
      );
      position: relative;
      box-shadow: 0 8px 18px rgba(124, 63, 29, 0.28);
      z-index: 30;
    }

    .market-awning::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -14px;
      height: 14px;
      background: radial-gradient(circle at 28px 0, #ef4444 26px, transparent 27px),
                  radial-gradient(circle at 84px 0, #fffbeb 26px, transparent 27px);
      background-size: 112px 14px;
      filter: drop-shadow(0 4px 3px rgba(0,0,0,0.15));
    }

    /* Wooden Counter & Beams */
    .wood-panel {
      background: linear-gradient(180deg, #b86532 0%, #8e471e 100%);
      border: 4px solid #5c2b0e;
      box-shadow: inset 0 3px 0 rgba(255, 220, 180, 0.35), 0 8px 20px rgba(0,0,0,0.3);
    }

    .wood-plank-bottom {
      background: repeating-linear-gradient(
        90deg,
        #9a4e23 0px,
        #9a4e23 140px,
        #7c3d19 140px,
        #7c3d19 144px
      );
      border-top: 6px solid #5c2b0e;
      box-shadow: inset 0 6px 12px rgba(255, 210, 160, 0.25);
    }

    /* Chunky Preschool Buttons */
    .btn-preschool {
      transition: transform 0.14s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.14s ease;
      cursor: pointer;
    }
    .btn-preschool:hover {
      transform: translateY(-3px) scale(1.02);
    }
    .btn-preschool:active {
      transform: translateY(3px) scale(0.98);
    }

    /* Produce Card Styling */
    .produce-card {
      background: #ffffff;
      border-radius: 28px;
      border: 8px solid #f59e0b;
      box-shadow: 0 16px 35px rgba(0, 0, 0, 0.32), inset 0 0 0 4px #fef3c7;
      transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .produce-card.active-side {
      transform: scale(1.06);
      border-color: #38bdf8;
      box-shadow: 0 0 0 10px rgba(56, 189, 248, 0.55), 0 20px 45px rgba(0, 0, 0, 0.4);
    }

    .produce-card.correct-card {
      border-color: #22c55e !important;
      background: #f0fdf4 !important;
      box-shadow: 0 0 0 14px rgba(34, 197, 94, 0.65), 0 25px 50px rgba(0, 0, 0, 0.45) !important;
      transform: scale(1.08);
    }

    .produce-card.wrong-card {
      border-color: #ef4444 !important;
      background: #fef2f2 !important;
      opacity: 0.72;
      transform: scale(0.95);
    }

    /* Mirrored Webcam Video */
    #webcam-video {
      transform: scaleX(-1);
      object-fit: cover;
    }

    /* Animations */
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-7px); }
    }
    .animate-float {
      animation: floatSlow 3s ease-in-out infinite;
    }

    @keyframes popIn {
      0% { transform: scale(0.5); opacity: 0; }
      75% { transform: scale(1.08); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    .animate-pop {
      animation: popIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    @keyframes pulseUrgent {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.14); }
    }
    .timer-urgent {
      animation: pulseUrgent 0.6s infinite;
    }

    /* Custom Scrollbar for Settings */
    ::-webkit-scrollbar {
      width: 10px;
    }
    ::-webkit-scrollbar-track {
      background: #fef3c7;
      border-radius: 999px;
    }
    ::-webkit-scrollbar-thumb {
      background: #d97706;
      border-radius: 999px;
    }
  </style>
</head>
<body>

<div id="stage-wrapper">
  <!-- Decorative Background Clouds & Sun -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
    <div class="absolute top-14 right-12 w-24 h-24 rounded-full bg-yellow-300 shadow-[0_0_50px_#fde047] opacity-90"></div>
    <svg class="absolute top-16 left-10 w-36 h-16 text-white/80" viewBox="0 0 120 50" fill="currentColor">
      <path d="M25,45 H95 A20,20 0 0,0 95,5 A25,25 0 0,0 50,10 A18,18 0 0,0 25,45 Z"/>
    </svg>
    <svg class="absolute top-24 right-1/3 w-44 h-20 text-white/70" viewBox="0 0 120 50" fill="currentColor">
      <path d="M25,45 H95 A20,20 0 0,0 95,5 A25,25 0 0,0 50,10 A18,18 0 0,0 25,45 Z"/>
    </svg>
  </div>

  <!-- TOP MARKET AWNING & HEADER BAR -->
  <header class="market-awning px-5 py-2.5 flex items-center justify-between shrink-0">
    <!-- Left Brand & Score -->
    <div class="flex items-center gap-3">
      <button onclick="goHome()" class="btn-preschool bg-amber-100 hover:bg-white text-amber-950 border-4 border-amber-800 rounded-2xl px-3.5 py-1.5 flex items-center gap-2 shadow-md" title="Back to Mode Selection">
        <span class="text-2xl">🧺</span>
        <span class="font-extrabold text-lg tracking-wide hidden sm:inline">Sunny Stand</span>
      </button>

      <!-- Score Pill -->
      <div id="score-badge" class="hidden bg-white/95 border-4 border-amber-600 rounded-2xl px-4 py-1 flex items-center gap-2 shadow-md">
        <span class="text-xl">⭐</span>
        <span class="font-black text-amber-900 text-lg"><span id="score-count">0</span> / <span id="round-total">0</span></span>
      </div>
    </div>

    <!-- Center Active Mode Switcher -->
    <div class="flex items-center gap-2 bg-amber-950/85 p-1.5 rounded-2xl border-2 border-amber-300/60 shadow-lg">
      <button id="btn-switch-fruit" onclick="switchMode('fruit')" class="btn-preschool px-4 py-1.5 rounded-xl font-extrabold text-base flex items-center gap-1.5 transition-colors bg-orange-500 text-white shadow">
        <span>🍎</span>
        <span>Fruits</span>
      </button>
      <button id="btn-switch-veg" onclick="switchMode('vegetable')" class="btn-preschool px-4 py-1.5 rounded-xl font-extrabold text-base flex items-center gap-1.5 transition-colors text-amber-100 hover:bg-white/10">
        <span>🥦</span>
        <span>Vegetables</span>
      </button>
    </div>

    <!-- Right Controls: Camera, Sound, Add Pictures (Settings), Fullscreen -->
    <div class="flex items-center gap-2">
      <button id="btn-cam-toggle" onclick="toggleCamera()" class="btn-preschool bg-sky-100 hover:bg-white text-sky-900 border-4 border-sky-700 rounded-2xl px-3 py-1.5 font-bold text-sm flex items-center gap-1.5 shadow-md" title="Toggle Webcam Motion Detection">
        <span id="cam-status-icon" class="text-lg">📷</span>
        <span id="cam-status-text" class="hidden md:inline">Camera On</span>
      </button>

      <button id="btn-sound-toggle" onclick="toggleSound()" class="btn-preschool bg-emerald-100 hover:bg-white text-emerald-900 border-4 border-emerald-700 rounded-2xl p-2 shadow-md" title="Toggle Sound">
        <span id="sound-icon" class="text-xl leading-none">🔊</span>
      </button>

      <button onclick="openSettings()" class="btn-preschool bg-amber-300 hover:bg-amber-200 text-amber-950 border-4 border-amber-800 rounded-2xl px-3.5 py-1.5 font-extrabold text-sm flex items-center gap-1.5 shadow-md" title="Add Custom Pictures">
        <span class="text-lg">⚙️</span>
        <span class="hidden sm:inline">Add Pictures</span>
      </button>

      <button onclick="toggleFullscreen()" class="btn-preschool bg-white hover:bg-slate-100 text-slate-800 border-4 border-slate-700 rounded-2xl p-2 shadow-md" title="Toggle Fullscreen">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
        </svg>
      </button>
    </div>
  </header>

  <!-- MAIN CONTENT STAGE -->
  <main class="relative flex-1 flex flex-col items-center justify-center p-4 z-10 overflow-hidden">

    <!-- SCREEN 1: MODE SELECTION (FRUITS OR VEGETABLES) -->
    <section id="screen-select" class="w-full max-w-4xl flex flex-col items-center justify-center text-center animate-pop">
      <div class="wood-panel rounded-3xl px-8 py-5 mb-7 max-w-2xl">
        <h1 class="text-3xl sm:text-5xl font-black text-amber-50 drop-shadow-[0_3px_0_#451a03] tracking-wide">
          Welcome to the Produce Stand!
        </h1>
        <p class="text-amber-200 text-lg sm:text-xl font-bold mt-1">
          Pick a basket to start playing!
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-10 w-full max-w-3xl px-4">
        <!-- Fruits Choice Card -->
        <button onclick="selectCategory('fruit')" class="btn-preschool group bg-gradient-to-b from-orange-400 to-red-500 border-8 border-white rounded-[36px] p-6 sm:p-8 shadow-[0_18px_35px_rgba(0,0,0,0.28)] flex flex-col items-center">
          <div class="w-32 h-32 sm:w-40 sm:h-40 bg-white/95 rounded-full flex items-center justify-center shadow-inner mb-4 group-hover:scale-105 transition-transform">
            <span class="text-7xl sm:text-8xl">🍓</span>
          </div>
          <span class="text-3xl sm:text-4xl font-black text-white drop-shadow-[0_3px_0_rgba(0,0,0,0.3)]">
            Fruits
          </span>
          <span class="mt-2 bg-white/25 text-white font-bold px-4 py-1 rounded-full text-sm">
            <span id="fruit-count-label">6</span> Pictures Ready
          </span>
        </button>

        <!-- Vegetables Choice Card -->
        <button onclick="selectCategory('vegetable')" class="btn-preschool group bg-gradient-to-b from-lime-500 to-emerald-600 border-8 border-white rounded-[36px] p-6 sm:p-8 shadow-[0_18px_35px_rgba(0,0,0,0.28)] flex flex-col items-center">
          <div class="w-32 h-32 sm:w-40 sm:h-40 bg-white/95 rounded-full flex items-center justify-center shadow-inner mb-4 group-hover:scale-105 transition-transform">
            <span class="text-7xl sm:text-8xl">🥕</span>
          </div>
          <span class="text-3xl sm:text-4xl font-black text-white drop-shadow-[0_3px_0_rgba(0,0,0,0.3)]">
            Vegetables
          </span>
          <span class="mt-2 bg-white/25 text-white font-bold px-4 py-1 rounded-full text-sm">
            <span id="veg-count-label">6</span> Pictures Ready
          </span>
        </button>
      </div>

      <!-- Quick Prompt to Load "F and V game" folder -->
      <div class="mt-6 bg-white/85 backdrop-blur-sm border-2 border-amber-400 rounded-2xl px-5 py-2.5 flex items-center gap-3 shadow-md">
        <span class="text-2xl">📁</span>
        <p class="text-amber-950 font-bold text-sm sm:text-base">
          Have your own <span class="underline decoration-orange-500 decoration-2">"F and V game"</span> photos?
          <button onclick="openSettings()" class="text-orange-600 hover:text-orange-700 font-black underline ml-1">Add them here!</button>
        </p>
      </div>
    </section>

    <!-- SCREEN 2: INSTRUCTION & START SCREEN -->
    <section id="screen-ready" class="hidden w-full max-w-3xl flex flex-col items-center justify-center text-center animate-pop">
      <div class="bg-white border-8 border-amber-500 rounded-[40px] p-7 sm:p-10 shadow-2xl w-full flex flex-col items-center">
        <div id="ready-badge" class="px-5 py-1.5 rounded-full text-white font-black text-lg uppercase tracking-wider mb-4 bg-orange-500">
          Fruits Mode
        </div>

        <div id="ready-emoji" class="text-8xl sm:text-9xl mb-4 animate-float">🍎</div>

        <!-- Required Exact Instruction Text -->
        <h2 id="ready-instruction" class="text-4xl sm:text-6xl font-black text-slate-800 mb-3 tracking-tight">
          Choose the fruit.
        </h2>

        <p class="text-slate-600 font-bold text-lg sm:text-xl max-w-xl mb-7">
          Stand on the side of the screen that shows the matching picture before the <span class="text-amber-600 font-black">5-second</span> timer finishes!
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <button onclick="goHome()" class="btn-preschool bg-slate-200 hover:bg-slate-300 text-slate-700 font-extrabold text-xl px-7 py-4 rounded-3xl border-b-4 border-slate-400">
            ← Back
          </button>
          <button onclick="startRound()" class="btn-preschool bg-gradient-to-b from-green-400 to-green-600 hover:from-green-500 hover:to-green-700 text-white font-black text-3xl sm:text-4xl px-12 py-5 rounded-3xl border-b-8 border-green-800 shadow-xl flex items-center gap-3">
            <span>▶</span>
            <span>Start</span>
          </button>
        </div>
      </div>
    </section>

    <!-- SCREEN 3: ACTIVE GAMEPLAY ARENA -->
    <section id="screen-play" class="hidden relative w-full h-full flex flex-col justify-between rounded-3xl overflow-hidden border-8 border-amber-800 bg-slate-900 shadow-2xl">
      
      <!-- Live Mirrored Webcam Feed Background -->
      <video id="webcam-video" autoplay playsinline muted class="absolute inset-0 w-full h-full object-cover opacity-90"></video>

      <!-- Fallback Background if Camera is Off/Unavailable -->
